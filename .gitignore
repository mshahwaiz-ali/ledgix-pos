# Installed/generated Frappe + ERPNext bench. Recreated by install/deploy scripts.
# Do not vendor upstream Frappe/ERPNext or site runtime data into this repo.
/frappe-bench/
/frappe-bench.incomplete-*/
/frappe-bench-*/

# Runtime output and logs.
logs/
backups/
/offline_bundle/
*.log
*.pid
.expose-state

# Secrets and machine-specific config.
.env
.env.*
*.env.local
config/*.env
!config/example.env
docs/private/secrets.md
deploy/production.secrets.md
deploy/backups-index.md
*.backup.*
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.tar
*.tgz

# Local generated secrets.
.secrets/

# Local editor/agent state.
.codex/
.agents/
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*.tmp
*.bak

# Python/Node/build/test caches.
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
apps/*/build/
apps/*.egg-info/
apps/*/*.egg-info/

# Local Python environments (directory, symlink, or file at repo root).
/env
/venv
/.venv
