# Frappe bench runtime.
# Track only Ledgix-owned apps in their actual bench runtime location.
# Frappe, ERPNext, sites, env, logs and other bench runtime remain untracked.
/frappe-bench/*
!/frappe-bench/apps/
/frappe-bench/apps/*
!/frappe-bench/apps/ledgix_saas/
!/frappe-bench/apps/ledgix_saas/**
!/frappe-bench/apps/fbr_v1/
!/frappe-bench/apps/fbr_v1/**
!/frappe-bench/apps/fbr_v12/
!/frappe-bench/apps/fbr_v12/**
/frappe-bench.incomplete-*/
/frappe-bench-*/

# Old duplicate app-source location must not return.
/apps/

# Runtime output and logs.
logs/
backups/
/offline_bundle/
*.log
*.pid
.expose-state

# Secrets and machine-specific config.
.env
.env.*
*.env.local
config/*.env
!config/example.env
docs/private/secrets.md
deploy/production.secrets.md
deploy/backups-index.md
*.backup.*
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.tar
*.tgz

# Local generated secrets.
.secrets/

# Local editor/agent state.
.codex/
.agents/
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*.tmp
*.bak

# Python/Node/build/test caches.
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
apps/*/build/
*.egg-info/

# Local Python environments (directory, symlink, or file at repo root).
/env
/venv
/.venv

# Local tooling and generated Python/runtime residue.
/frappe-bench/apps/*.before-sync-*/
