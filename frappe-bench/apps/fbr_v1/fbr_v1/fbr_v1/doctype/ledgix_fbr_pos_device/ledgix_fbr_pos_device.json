{
 "doctype": "DocType",
 "name": "Ledgix FBR POS Device",
 "module": "FBR V1",
 "autoname": "hash",
 "engine": "InnoDB",
 "field_order": [
  "company",
  "pos_profile",
  "outlet_address",
  "display_label",
  "pos_id",
  "software_registration_number",
  "environment",
  "transport_topology",
  "onboarding_reference",
  "onboarding_evidence",
  "active",
  "operational_state",
  "last_successful_fiscalization",
  "last_daily_closing",
  "last_weekly_closing",
  "last_monthly_closing",
  "ims_package_section",
  "ims_package_name",
  "ims_package_version",
  "ims_installation_reference",
  "ims_installation_evidence",
  "qr_section",
  "qr_verification_status",
  "qr_verification_reference",
  "qr_verification_evidence",
  "qr_column",
  "qr_verified_at",
  "qr_verified_by",
  "signature_section",
  "signature_verification_status",
  "signature_verification_reference",
  "signature_verification_evidence",
  "signature_column",
  "signature_verified_at",
  "signature_verified_by"
 ],
 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "pos_profile",
   "fieldtype": "Link",
   "label": "Pos Profile",
   "options": "POS Profile"
  },
  {
   "fieldname": "outlet_address",
   "fieldtype": "Link",
   "label": "Outlet Address",
   "options": "Address"
  },
  {
   "fieldname": "display_label",
   "fieldtype": "Data",
   "label": "Display Label",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "reqd": 1
  },
  {
   "fieldname": "pos_id",
   "fieldtype": "Data",
   "label": "Pos Id"
  },
  {
   "fieldname": "software_registration_number",
   "fieldtype": "Data",
   "label": "FBR POS / Software Registration No."
  },
  {
   "fieldname": "environment",
   "fieldtype": "Select",
   "label": "Environment",
   "options": "Sandbox\nProduction",
   "default": "Sandbox",
   "reqd": 1
  },
  {
   "fieldname": "transport_topology",
   "fieldtype": "Select",
   "label": "Transport Topology",
   "options": "Local IMS - Server Reachable\nCloud API\nWorkstation Local - Unsupported\nUnresolved",
   "default": "Unresolved",
   "reqd": 1
  },
  {
   "fieldname": "onboarding_reference",
   "fieldtype": "Data",
   "label": "Onboarding Reference",
   "hidden": 1
  },
  {
   "fieldname": "onboarding_evidence",
   "fieldtype": "Attach",
   "label": "Onboarding Evidence",
   "hidden": 1
  },
  {
   "fieldname": "active",
   "fieldtype": "Check",
   "label": "Active",
   "default": "0"
  },
  {
   "fieldname": "operational_state",
   "fieldtype": "Select",
   "label": "Operational State",
   "options": "Unresolved\nOperational\nOffline",
   "default": "Unresolved",
   "read_only": 1
  },
  {
   "fieldname": "last_successful_fiscalization",
   "fieldtype": "Datetime",
   "label": "Last Successful Fiscalization",
   "read_only": 1
  },
  {
   "fieldname": "last_daily_closing",
   "fieldtype": "Datetime",
   "label": "Last Daily Closing",
   "read_only": 1
  },
  {
   "fieldname": "last_weekly_closing",
   "fieldtype": "Datetime",
   "label": "Last Weekly Closing",
   "read_only": 1
  },
  {
   "fieldname": "last_monthly_closing",
   "fieldtype": "Datetime",
   "label": "Last Monthly Closing",
   "read_only": 1
  },
  {
   "fieldname": "ims_package_section",
   "fieldtype": "Section Break",
   "label": "IMS Package and Installation",
   "depends_on": "eval:doc.transport_topology=='Local IMS - Server Reachable'",
   "collapsible": 1
  },
  {
   "fieldname": "ims_package_name",
   "fieldtype": "Data",
   "label": "IMS Package Name",
   "depends_on": "eval:doc.transport_topology=='Local IMS - Server Reachable'"
  },
  {
   "fieldname": "ims_package_version",
   "fieldtype": "Data",
   "label": "IMS Package Version",
   "depends_on": "eval:doc.transport_topology=='Local IMS - Server Reachable'"
  },
  {
   "fieldname": "ims_installation_reference",
   "fieldtype": "Data",
   "label": "IMS Installation Reference",
   "depends_on": "eval:doc.transport_topology=='Local IMS - Server Reachable'"
  },
  {
   "fieldname": "ims_installation_evidence",
   "fieldtype": "Attach",
   "label": "IMS Installation Evidence",
   "depends_on": "eval:doc.transport_topology=='Local IMS - Server Reachable'"
  },
  {
   "fieldname": "qr_section",
   "fieldtype": "Section Break",
   "label": "QR Verification",
   "hidden": 1
  },
  {
   "fieldname": "qr_verification_status",
   "fieldtype": "Select",
   "label": "QR Verification Status",
   "options": "Unverified\nVerified",
   "default": "Unverified",
   "hidden": 1
  },
  {
   "fieldname": "qr_verification_reference",
   "fieldtype": "Data",
   "label": "QR Verification Reference",
   "hidden": 1
  },
  {
   "fieldname": "qr_verification_evidence",
   "fieldtype": "Attach",
   "label": "QR Verification Evidence",
   "hidden": 1
  },
  {
   "fieldname": "qr_column",
   "fieldtype": "Column Break",
   "label": "QR Column",
   "hidden": 1
  },
  {
   "fieldname": "qr_verified_at",
   "fieldtype": "Datetime",
   "label": "QR Verified At",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "qr_verified_by",
   "fieldtype": "Link",
   "label": "QR Verified By",
   "options": "User",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "signature_section",
   "fieldtype": "Section Break",
   "label": "Fiscal Signature Verification",
   "hidden": 1
  },
  {
   "fieldname": "signature_verification_status",
   "fieldtype": "Select",
   "label": "Signature Verification Status",
   "options": "Unverified\nVerified",
   "default": "Unverified",
   "hidden": 1
  },
  {
   "fieldname": "signature_verification_reference",
   "fieldtype": "Data",
   "label": "Signature Verification Reference",
   "hidden": 1
  },
  {
   "fieldname": "signature_verification_evidence",
   "fieldtype": "Attach",
   "label": "Signature Verification Evidence",
   "hidden": 1
  },
  {
   "fieldname": "signature_column",
   "fieldtype": "Column Break",
   "label": "Signature Column",
   "hidden": 1
  },
  {
   "fieldname": "signature_verified_at",
   "fieldtype": "Datetime",
   "label": "Signature Verified At",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "signature_verified_by",
   "fieldtype": "Link",
   "label": "Signature Verified By",
   "options": "User",
   "read_only": 1,
   "hidden": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "create": 1,
   "write": 1,
   "delete": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Ledgix Admin",
   "read": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "create": 1,
   "write": 1,
   "delete": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Accounts Manager",
   "read": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "Ledgix Manager",
   "read": 1,
   "report": 1,
   "print": 1,
   "export": 1
  },
  {
   "role": "Accounts User",
   "read": 1,
   "report": 1,
   "print": 1,
   "export": 1
  }
 ],
 "track_changes": 1,
 "allow_rename": 0,
 "title_field": "display_label",
 "show_title_field_in_link": 1,
 "search_fields": "display_label,pos_id,company,pos_profile"
}
