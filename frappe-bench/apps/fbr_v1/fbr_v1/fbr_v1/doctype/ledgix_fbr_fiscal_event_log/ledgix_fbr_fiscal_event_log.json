{
 "doctype": "DocType",
 "name": "Ledgix FBR Fiscal Event Log",
 "module": "FBR V1",
 "autoname": "hash",
 "engine": "InnoDB",
 "field_order": [
  "pos_device",
  "event_type",
  "occurred_at",
  "reference_doctype",
  "reference_name",
  "external_reference",
  "event_json",
  "event_hash",
  "severity",
  "created_by",
  "external_evidence"
 ],
 "fields": [
